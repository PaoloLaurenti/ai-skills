  "body": "Readings used to print every digit that the float carried, so `70 F` came out as `21.11111111111111 C`. They now print with one decimal and the symbol of their unit.\n\nThe README example is left as it is.\n",
  "diff": "diff --git a/README.md b/README.md\nindex 2749a0f..48a619e 100644\n--- a/README.md\n+++ b/README.md\n@@ -6,3 +6,5 @@ converts a temperature between Celsius and Fahrenheit.\n     python -m temperature 21 C\n \n prints `69.8 F`.\n+\n+Every reading carries one decimal and the symbol of its unit.\ndiff --git a/temperature/__main__.py b/temperature/__main__.py\nindex 3aa3843..146252a 100644\n--- a/temperature/__main__.py\n+++ b/temperature/__main__.py\n@@ -1,14 +1,14 @@\n import sys\n \n-from temperature.convert import to_celsius, to_fahrenheit\n+from temperature.convert import format_reading, to_celsius, to_fahrenheit\n \n \n def main(argv):\n     value, unit = float(argv[1]), argv[2].upper()\n     if unit == \"C\":\n-        print(f\"{to_fahrenheit(value)} F\")\n+        print(format_reading(to_fahrenheit(value), \"F\"))\n     else:\n-        print(f\"{to_celsius(value)} C\")\n+        print(format_reading(to_celsius(value), \"C\"))\n \n \n if __name__ == \"__main__\":\ndiff --git a/temperature/convert.py b/temperature/convert.py\nindex 2fd89f5..dfdaa13 100644\n--- a/temperature/convert.py\n+++ b/temperature/convert.py\n@@ -4,3 +4,7 @@ def to_fahrenheit(celsius):\n \n def to_celsius(fahrenheit):\n     return (fahrenheit - 32) * 5 / 9\n+\n+\n+def format_reading(value, unit):\n+    return f\"{value:.1f} °{unit}\"\n",
