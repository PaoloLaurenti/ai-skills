  "number": 1,
  "title": "mark items at or below five units as low in the report",
  "state": "open",
  "head_ref": "guided-1",
  "base_ref": "main",
  "author": "fixture-owner",
  "viewer": "fixture-owner",
  "body": "Items at or below five units are now marked as low in the report, so they can be reordered before they run out.\n\n- `Stock.is_low` says whether an item is low, against the new `LOW_STOCK` threshold.\n- The report adds ` (low)` after the level of every low item.\n",
  "diff": "diff --git a/stock/levels.py b/stock/levels.py\nindex e4cf721..27b1b8a 100644\n--- a/stock/levels.py\n+++ b/stock/levels.py\n@@ -1,3 +1,7 @@\n+# An item at or below this many units is low.\n+LOW_STOCK = 5\n+\n+\n class Stock:\n     def __init__(self, levels):\n         self.levels = dict(levels)\n@@ -7,3 +11,6 @@ def add(self, item, quantity):\n \n     def remove(self, item, quantity):\n         self.levels[item] = max(0, self.levels.get(item, 0) - quantity)\n+\n+    def is_low(self, item):\n+        return self.levels.get(item, 0) < LOW_STOCK\ndiff --git a/stock/report.py b/stock/report.py\nindex 817f5d3..1f1373e 100644\n--- a/stock/report.py\n+++ b/stock/report.py\n@@ -1,5 +1,6 @@\n def report(stock):\n     lines = []\n     for item in sorted(stock.levels):\n-        lines.append(f\"{item}: {stock.levels[item]}\")\n+        marker = \" (low)\" if stock.is_low(item) else \"\"\n+        lines.append(f\"{item}: {stock.levels[item]}{marker}\")\n     return \"\\n\".join(lines)\ndiff --git a/tests/test_levels.py b/tests/test_levels.py\nindex 05112de..e4be121 100644\n--- a/tests/test_levels.py\n+++ b/tests/test_levels.py\n@@ -5,3 +5,8 @@ def test_removing_more_than_there_is_leaves_zero():\n     stock = Stock({\"apples\": 2})\n     stock.remove(\"apples\", 5)\n     assert stock.levels[\"apples\"] == 0\n+\n+\n+def test_an_item_under_the_threshold_is_low():\n+    stock = Stock({\"pears\": 3})\n+    assert stock.is_low(\"pears\")\n",
  "head_sha": "8c173b6706c1e3424d7d97d59f2909b9fb51e23c",
